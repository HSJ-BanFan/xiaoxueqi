# Copy to backend/.env (or project root if you load from there)
# cp .env.example backend/.env

# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=11520
AUTO_CREATE_TABLES=true
SCHEDULER_ENABLED=false

# --- Database ---
# SQLite (default, recommended for local demo)
DATABASE_URL=sqlite:///./diabetes_assistant.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/diabetes_assistant

# --- CORS (optional override; comma-separated) ---
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# --- Agent / LLM (OpenAI-compatible) ---
AGENT_ENABLED=true
AGENT_REQUIRE_CONFIRM_WRITE=true
LLM_PROVIDER=openai_compatible
# Example local OpenAI-compatible endpoint; replace with your provider.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=local-development-key
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ROUNDS=4
LLM_TEMPERATURE=0.3

# --- Legacy model fields (older ml/ollama modules) ---
MODEL_PROVIDER=disabled
MODEL_NAME=qwen2.5:7b
MODEL_DEVICE=cpu

# --- Optional local setup/manual smoke scripts ---
# ADMIN_EMAIL=admin@local.test
# ADMIN_PASSWORD=choose-a-strong-local-password
# TEST_USER_EMAIL=user@local.test
# TEST_USER_PASSWORD=choose-a-test-password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=replace-me
# MYSQL_DATABASE=diabetes_assistant
